{
  "name": "gliststudio",
  "productName": "Glist Studio",
  "desktopName": "gliststudio.desktop",
  "version": "0.1.0",
  "description": "A focused desktop IDE for Glist Engine projects",
  "main": ".webpack/main",
  "private": true,
  "scripts": {
    "start": "electron-forge start",
    "web": "jiti scripts/web.ts",
